---
layout: layouts/base.njk
lang: bg
title: "Mobility Label | {{ site.siteName.bg }}"
permalink: "/bg/mobility-labelling/"
---
<section class="container-lg py-5">
  <div class="row g-5 align-items-start">
    <div class="col-lg-7">
      <h1 class="display-4 fw-bold mb-4">
        <i class="bi bi-tags" style="color: #10b981;"></i> {{ site.translations[lang].mobilityTitle }}
      </h1>
      <div class="card card-cta mb-4">
        <div class="card-body">
          <p class="lead mb-4" style="color: #475569;">{{ site.translations[lang].mobilityExplain }}</p>
          <p>{{ site.translations[lang].mobilityText }}</p>
        </div>
      </div>
      
      <div class="row g-3 mt-4">
        <div class="col-12">
          <a class="btn btn-primary btn-lg w-100 py-3" href="{{ site.demoUrl }}" target="_blank" rel="noreferrer">
            <i class="bi bi-play-circle"></i> {{ site.translations[lang].mobilityButton }} - Отворете демото
          </a>
        </div>
        <div class="col-12">
          <a class="btn btn-outline-secondary btn-lg w-100 py-3" href="/{{ '' if lang == 'it' else lang ~ '/' }}">
            <i class="bi bi-arrow-left"></i> Назад към начало
          </a>
        </div>
      </div>
    </div>

    <div class="col-lg-5 text-center">
      <a href="{{ site.demoUrl }}" target="_blank" rel="noreferrer" title="Отворете демото">
        <img src="/assets/images/mobility-label.jpg" alt="Маркировка за мобилност" class="img-fluid rounded shadow" style="transition: transform .3s;" onmouseover="this.style.transform='scale(1.03)'" onmouseout="this.style.transform='scale(1)'">
      </a>
      <p class="text-muted small mt-2"><i class="bi bi-cursor"></i> Кликнете върху изображението за демото</p>
    </div>
  </div>
</section>
