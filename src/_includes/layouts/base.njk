<!doctype html>
<html lang="{{ lang }}">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ page.title }} | {{ site.siteName[lang] }}</title>
    <link rel="stylesheet" href="/css/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/fonts/bootstrap-icons/bootstrap-icons.css" />
    <style>
      :root {
        --primary-color: #0d6efd;
        --secondary-color: #10b981;
        --accent-color: #f59e0b;
        --dark-bg: #0f172a;
        --text-light: #f1f5f9;
        --text-muted: #94a3b8;
      }

      * { transition: all 0.3s ease; }
      
      body {
        padding-top: 80px;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        color: #1e293b;
      }

      /* Navbar */
      .navbar {
        background: linear-gradient(135deg, var(--dark-bg) 0%, #1e293b 100%);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid rgba(255,255,255,.1);
        box-shadow: 0 4px 20px rgba(0,0,0,.15);
      }

      .navbar-brand {
        font-size: 1.5rem;
        font-weight: 800;
        background: linear-gradient(135deg, #10b981 0%, #06b6d4 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }

      .nav-link {
        color: var(--text-light) !important;
        font-weight: 500;
        position: relative;
        margin: 0 0.5rem;
      }

      .nav-link::after {
        content: '';
        position: absolute;
        width: 0;
        height: 2px;
        bottom: -5px;
        left: 0;
        background: linear-gradient(90deg, #10b981, #06b6d4);
        transition: width 0.3s ease;
      }

      .nav-link:hover::after {
        width: 100%;
      }

      /* Hero Section */
      .hero {
        min-height: 65vh;
        display: flex;
        align-items: center;
        overflow: hidden;
        position: relative;
      }

      .hero::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(135deg, rgba(16, 185, 129, 0.1) 0%, rgba(6, 182, 212, 0.05) 100%);
        z-index: 0;
        pointer-events: none;
      }

      .hero-bg {
        background: linear-gradient(180deg, #f0fdf4 0%, #ecf0f1 50%, #ffffff 100%);
        position: relative;
        z-index: 1;
      }

      .hero h1 {
        font-size: clamp(2rem, 8vw, 3.5rem);
        font-weight: 900;
        background: linear-gradient(135deg, #0d6efd 0%, #10b981 50%, #06b6d4 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        line-height: 1.2;
        margin-bottom: 1.5rem;
      }

      .hero .lead {
        font-size: 1.25rem;
        color: #475569;
        line-height: 1.8;
        margin-bottom: 2rem;
      }

      /* Buttons */
      .btn-primary {
        background: linear-gradient(135deg, #0d6efd 0%, #0d6efd 100%);
        border: none;
        padding: 0.75rem 2rem;
        font-weight: 600;
        border-radius: 8px;
        box-shadow: 0 4px 15px rgba(13, 110, 253, 0.3);
        position: relative;
        overflow: hidden;
      }

      .btn-primary::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,.3), transparent);
        transition: left 0.5s ease;
        pointer-events: none;
      }

      .btn-primary:hover::before {
        left: 100%;
      }

      .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(13, 110, 253, 0.4);
      }

      .btn-outline-primary {
        color: var(--primary-color);
        border-color: var(--primary-color);
        border-width: 2px;
      }

      .btn-outline-primary:hover {
        background: var(--primary-color);
        transform: translateY(-2px);
        box-shadow: 0 4px 15px rgba(13, 110, 253, 0.2);
      }

      /* Sections */
      section {
        position: relative;
      }

      .section-title {
        font-size: 2.5rem;
        font-weight: 800;
        margin-bottom: 2.5rem;
        color: #0f172a;
        position: relative;
        display: inline-block;
      }

      .section-title::after {
        content: '';
        position: absolute;
        bottom: -10px;
        left: 0;
        width: 60px;
        height: 4px;
        background: linear-gradient(90deg, #10b981, #06b6d4);
        border-radius: 2px;
        pointer-events: none;
      }

      #project-history {
        background: #ffffff;
      }

      #areas {
        background: linear-gradient(180deg, #f0fdf4 0%, #ecf0f1 100%);
      }

      #areas .list-group-item {
        background: rgba(255,255,255,.7);
        border: 1px solid rgba(16, 185, 129, 0.2);
        padding: 1rem 1.5rem;
        margin-bottom: 0.5rem;
        border-radius: 8px;
        font-weight: 500;
        transition: all 0.3s ease;
      }

      #areas .list-group-item:hover {
        background: rgba(255,255,255, .95);
        border-color: #10b981;
        transform: translateX(5px);
        box-shadow: 0 4px 12px rgba(16, 185, 129, 0.1);
      }

      #areas .list-group-item::before {
        content: '✓';
        margin-right: 0.75rem;
        color: #10b981;
        font-weight: bold;
        pointer-events: none;
      }

      #boxed {
        background: #ffffff;
        padding: 4rem 0 !important;
      }

      /* Cards */
      .card-cta {
        border: none;
        background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%);
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,.08);
        position: relative;
        border-top: 3px solid #10b981;
      }

      .card-cta::before {
        content: '';
        position: absolute;
        top: 0;
        right: -100px;
        width: 200px;
        height: 200px;
        background: radial-gradient(circle, rgba(16, 185, 129, 0.1) 0%, transparent 70%);
        border-radius: 50%;
        pointer-events: none;
      }

      .card-cta .card-body {
        position: relative;
        z-index: 1;
      }

      .card-cta .card-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 1rem;
      }

      .card-cta .card-text {
        color: #475569;
        line-height: 1.6;
        margin-bottom: 1.5rem;
      }

      .btn-demo {
        min-width: 220px;
        font-weight: 600;
        border-radius: 8px;
      }

      /* Form */
      #boxed-form {
        background: linear-gradient(135deg, #f0fdf4 0%, #f0f9ff 100%);
        padding: 2rem;
        border-radius: 12px;
        border: 1px solid rgba(16, 185, 129, 0.2);
      }

      #boxed-form input {
        border: 2px solid #e2e8f0;
        border-radius: 8px;
        padding: 0.75rem 1rem;
        font-weight: 500;
        transition: all 0.3s ease;
      }

      #boxed-form input:focus {
        border-color: #10b981;
        box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.1);
      }

      /* Footer */
      footer {
        background: linear-gradient(180deg, #0f172a 0%, #1e293b 100%);
        color: var(--text-light);
        padding: 3rem 0 1.5rem;
        border-top: 1px solid rgba(255,255,255,.1);
      }

      footer a {
        color: #10b981;
        text-decoration: none;
        font-weight: 600;
        transition: color 0.3s ease;
      }

      footer a:hover {
        color: #06b6d4;
      }

      footer small {
        color: var(--text-muted);
      }

      /* Utility */
      .bg-light {
        background: linear-gradient(180deg, #f0fdf4 0%, #ecf0f1 100%) !important;
      }

      .text-muted {
        color: #64748b !important;
      }

      /* Responsive */
      @media (max-width: 768px) {
        body { padding-top: 60px; }
        .hero h1 { font-size: 2rem; margin-bottom: 1rem; }
        .hero .lead { font-size: 1rem; }
        .section-title { font-size: 1.75rem; }
      }
    </style>
  </head>
  <body>
    {% include "partials/navbar.njk" %}
    <main>
      {{ content | safe }}
    </main>
    <footer class="text-center text-md-start mt-5">
      <div class="container-lg py-5">
        <div class="row g-4 align-items-center mb-4">
          <div class="col-md-3 text-center text-md-start">
            <img src="/assets/images/momabiz-logo.png" alt="MoMa.BIZ" height="50" class="mb-3">
          </div>
          <div class="col-md-6 text-md-start">
            <h5 class="mb-2">
              <i class="bi bi-speedometer2"></i> {{ site.siteName[lang] }}
            </h5>
            <small>{{ site.translations[lang].homeSubtitle }}</small>
          </div>
          <div class="col-md-3 text-md-end">
            <small>
              <i class="bi bi-envelope"></i> <a href="mailto:{{ site.downloadEmail }}">{{ site.downloadEmail }}</a>
            </small>
          </div>
        </div>
        <hr class="my-4" style="opacity: .2;">
        <div class="row">
          <div class="col-12">
            <small class="text-muted d-block mb-3">
              <strong>Disclaimer:</strong> The sole responsibility for the content of this website lies with the authors. It does not necessarily reflect the opinion of the European Union. The European Commission is not responsible for any use that may be made of the information contained therein.
            </small>
            <small class="text-muted">
              © 2026 MoMa.BIZ | Project financed by <a href="http://ec.europa.eu/energy/intelligent/" target="_blank">Intelligent Energy Europe 2014</a> | Powered by <a href="https://impronta48.it">iMpronta</a>
            </small>
          </div>
        </div>
      </div>
    </footer>
    <script src="/css/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script>
      document.addEventListener('submit', function(event) {
        if (event.target && event.target.id === 'boxed-form') {
          event.preventDefault();
          var email = event.target.querySelector('input[name="email"]').value.trim();
          if (!email || !email.includes('@')) {
            alert('{{ site.translations[lang].emailValidation }}');
            return;
          }
          var subject = encodeURIComponent('Richiesta Boxed Solutions');
          var body = encodeURIComponent('Salve, vorrei ricevere il kit Boxed Solutions.\nEmail: ' + email + '\n\nGrazie.');
          window.location.href = 'mailto:' + '{{ site.downloadEmail }}' + '?subject=' + subject + '&body=' + body;
        }
      });
    </script>
  </body>
</html>
