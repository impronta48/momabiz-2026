<div class="mt-4">
  <p class="fw-semibold mb-3">{{ site.translations[lang].boxedFormCta }}</p>
  <form
    action="https://b2b.bikesquare.eu/contacts/index/info@mobilitysquare.eu"
    method="post"
    id="contactForm">
    <input
      type="hidden"
      name="_next"
      value="https://mobilitysquare.eu" />

    <div class="form-floating mb-3">
      <input
        class="form-control"
        id="name"
        type="text"
        placeholder="Enter your name..."
        name="contactname"
        data-sb-validations="required" />
      <label for="name">{{ site.translations[lang].contactNameLabel }}</label>
      <div class="invalid-feedback" data-sb-feedback="name:required">
        {{ site.translations[lang].contactNameValidation }}
      </div>
    </div>

    <div class="form-floating mb-3">
      <input
        class="form-control"
        id="surname"
        type="text"
        placeholder="Enter your surname..."
        name="contactsurname"
        data-sb-validations="required" />
      <label for="surname">{{ site.translations[lang].contactSurnameLabel }}</label>
      <div class="invalid-feedback" data-sb-feedback="surname:required">
        {{ site.translations[lang].contactSurnameValidation }}
      </div>
    </div>

    <div class="form-floating mb-3">
      <input
        class="form-control"
        id="email"
        type="email"
        placeholder="name@example.com"
        name="_replyto"
        data-sb-validations="required,email" />
      <label for="email">{{ site.translations[lang].contactEmailLabel }}</label>
      <div class="invalid-feedback" data-sb-feedback="email:required">
        {{ site.translations[lang].contactEmailRequired }}
      </div>
      <div class="invalid-feedback" data-sb-feedback="email:email">
        {{ site.translations[lang].contactEmailInvalid }}
      </div>
    </div>

    <div class="form-floating mb-3">
      <input
        class="form-control"
        id="phone"
        type="tel"
        placeholder="(123) 456-7890"
        data-sb-validations="required"
        name="contacttelefono" />
      <label for="phone">{{ site.translations[lang].contactPhoneLabel }}</label>
      <div class="invalid-feedback" data-sb-feedback="phone:required">
        {{ site.translations[lang].contactPhoneValidation }}
      </div>
    </div>

    <div class="form-floating mb-3">
      <textarea
        class="form-control"
        name="contactmessage"
        id="message"
        type="text"
        placeholder="Enter your message here..."
        style="height: 10rem"
        data-sb-validations="required"></textarea>
      <label for="message">{{ site.translations[lang].contactMessageLabel }}</label>
      <div class="invalid-feedback" data-sb-feedback="message:required">
        {{ site.translations[lang].contactMessageValidation }}
      </div>
    </div>

    <button
      class="btn btn-primary"
      id="submitButton"
      type="submit">
      {{ site.translations[lang].contactSubmitLabel }}
    </button>
  </form>
</div>